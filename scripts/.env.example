# scripts/ (importadores, creación de usuarios, etc.) — copiar a scripts/.env y completar.
# OJO: service_role key es secreta y da acceso total a la DB. Nunca commitearla.
#
# Nota histórica: varios scripts leen estas vars desde apps/admin/.env.local.
# Documentado en docs/CHANGELOG.md (go-live): pasar las credenciales por archivo,
# no por `export` en el shell (zsh con clipboard sucio rompió intentos previos).

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
