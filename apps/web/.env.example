# apps/web (e-commerce, Next.js) — copiar a .env.local y completar.
# Si NO se setean SUPABASE_URL/ANON_KEY, la web cae a modo demo (datos mock en memoria).

# --- Supabase (dejar vacío para modo demo) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Branding / datos del comercio mostrados en la tienda ---
# (Multi-empresa: idealmente salen de configuracion_empresa resuelta por subdominio.)
NEXT_PUBLIC_BRAND_NAME=
NEXT_PUBLIC_SITE_NOMBRE=
NEXT_PUBLIC_DIRECCION=
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMERO=

# --- Prefijo de claves de localStorage (opcional; default "sc") ---
NEXT_PUBLIC_APP_KEY=

# --- Dominio raíz para resolución por subdominio (empresa.<ROOT_DOMAIN>) ---
NEXT_PUBLIC_ROOT_DOMAIN=

# --- Lista de precios de la tienda (UUID). Vacío = lista default de la empresa. ---
NEXT_PUBLIC_LISTA_PRECIO_ID=
