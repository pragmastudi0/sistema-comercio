# apps/pos (Vite) — copiar a .env.local y completar.
# Si NO se setean VITE_SUPABASE_URL/ANON_KEY, el PoS cae a modo demo (datos mock en memoria).

# --- Supabase (dejar vacío para modo demo) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Branding (opcional; default genérico "Comercio") ---
VITE_BRAND_NAME=
# Color del tema (manifest PWA / theme-color). Default azul "#2563eb".
VITE_THEME_COLOR=
# Prefijo de claves de localStorage (opcional; default "sc").
VITE_APP_KEY=

# --- URL del admin (botón de volver / SSO). SIN default: vacío = botón oculto. ---
VITE_ADMIN_URL=

# --- Operador del SaaS: bypass de permisos (listas separadas por comas) ---
VITE_SUPER_ADMIN_EMAILS=
VITE_PRAGMA_DEV_EMAILS=
