# apps/admin — copiar a .env.local y completar.
# Si NO se setean SUPABASE_URL/ANON_KEY, el admin cae a modo demo (datos mock en memoria).

# --- Supabase (dejar vacío para modo demo) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Branding (opcional; default genérico "Comercio") ---
NEXT_PUBLIC_BRAND_NAME=

# --- Prefijo de claves de localStorage (opcional; default "sc") ---
NEXT_PUBLIC_APP_KEY=

# --- URLs cruzadas entre apps (botones "Ir al PoS" / "Ver web") ---
# SIN default: si se dejan vacías, los botones no se muestran (nunca apuntan a otra instancia).
NEXT_PUBLIC_POS_URL=
NEXT_PUBLIC_WEB_URL=

# --- Operador del SaaS: bypass de permisos (listas separadas por comas) ---
NEXT_PUBLIC_SUPER_ADMIN_EMAILS=
NEXT_PUBLIC_PRAGMA_DEV_EMAILS=
