# apps/admin — copiar a .env.local y completar.
# Si NO se setean SUPABASE_URL/ANON_KEY, el admin cae a modo demo (datos mock en memoria).

# --- Supabase (dejar vacío para modo demo) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Branding (opcional; default "#turisteando") ---
NEXT_PUBLIC_BRAND_NAME=

# --- URLs cruzadas entre apps (para botones "Ir al PoS" / "Ver web") ---
# Defaults apuntan a los deploys de Turisteando; sobreescribir por cliente.
NEXT_PUBLIC_POS_URL=
NEXT_PUBLIC_WEB_URL=
